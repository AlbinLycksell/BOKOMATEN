# =============================================================
# Switchboard — web/.env.local TEMPLATE
# Copy this file to `web/.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit secrets.
# Full reference: /docs/env-variables.md
# =============================================================

# ---- NextAuth ------------------------------------------------
# Required. Without these, /api/auth/* throws "client_id is required".
NEXTAUTH_URL=http://localhost:3000
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# ---- Google OAuth (NextAuth login) ---------------------------
# Google Cloud Console → APIs & Services → Credentials → "Web application"
# Authorized redirect URI MUST include:
#   http://localhost:3000/api/auth/callback/google
#   https://<prod-host>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Backend bootstrap (server-only) -------------------------
# Where the Next.js server hits the FastAPI backend for the
# auth-bootstrap call. Server-only — never exposed to the browser.
SWITCHBOARD_BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Shared secret matched against the backend's
# `SWITCHBOARD_BOOTSTRAP_INTERNAL_TOKEN`. Required in prod.
SWITCHBOARD_BOOTSTRAP_INTERNAL_TOKEN=
# Demo / fallback firma id used if the bootstrap call fails. Dev only.
SWITCHBOARD_FALLBACK_FIRMA_ID=01J0000FIRM0ANDERSSONSVVS00

# ---- Server-side API base (admin SSR fetches) ----------------
# Used by Server Components in /admin to talk directly to the backend.
SWITCHBOARD_API_BASE=http://127.0.0.1:8000

# ---- Browser-exposed (NEXT_PUBLIC_*) -------------------------
# Backend HTTP base for the /api/proxy rewrite. Leave unset in dev to
# default to http://127.0.0.1:8000.
# NEXT_PUBLIC_BACKEND_URL=https://api.switchboard.se
# Backend WebSocket base. Bypasses Next.js dev rewrites (which only
# proxy HTTP, not WS). Leave unset in dev to default to ws://localhost:8000.
# NEXT_PUBLIC_BACKEND_WS_BASE=wss://api.switchboard.se
